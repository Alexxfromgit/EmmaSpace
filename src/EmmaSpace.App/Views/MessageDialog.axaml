<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmmaSpace.App.Views.MessageDialog"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20,24,20" Spacing="14">
    <TextBlock x:Name="HeadingText" Classes="h2" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource EmmaMutedBrush}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="SecondaryButton" Click="OnSecondary" Padding="16,7" CornerRadius="8" />
      <Button x:Name="PrimaryButton" Classes="accent" Click="OnPrimary" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
